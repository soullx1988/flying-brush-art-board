  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/express": "4.0.7",
    "@fastify/websocket": "11.3.0",
    "@infinite-board/board-core": "workspace:*",
    "@infinite-board/interop": "workspace:*",
    "@infinite-board/tldraw-adapter": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tldraw/sync": "5.2.5",
    "@tldraw/sync-core": "5.2.5",
    "better-sqlite3": "13.0.1",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "fastify": "5.10.0",
    "fflate": "0.8.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
